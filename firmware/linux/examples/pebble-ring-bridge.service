# Example unit for examples/pebble_ring_bridge.py. Run it as an account in
# the musegadget socket's group (the account musegadget runs commands as).

[Unit]
Description=Pebble ring webhook to a Muse side chat (via musegadget)
Wants=network-online.target
After=network-online.target musegadget.service

[Service]
User=@USER@
Environment=PEBBLE_SESSION_ID=@SESSION_ID@
Environment=PEBBLE_SECRET_FILE=/etc/pebble-bridge/secret
Environment=PEBBLE_PORT=8787
ExecStart=/usr/bin/python3 /opt/pebble-bridge/pebble_ring_bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
